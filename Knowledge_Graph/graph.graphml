    <node id="American Dogwood">
      <data key="d0">supplement</data>
      <data key="d1">Cornus florida</data>
      <data key="d2">Bitter Redberry | Box Tree | Boxwood | Budwood | Cornejo Florido | Cornel | Cornelian Tree | Cornouiller à Fleurs | Cornouiller à Fleurs d'Amérique | Cornouiller Américain</data>
